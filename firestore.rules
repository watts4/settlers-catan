rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Game rooms ──────────────────────────────────────────────────────────
    // A room's code is the invitation: anyone signed in (anonymously is fine)
    // who knows it may read that one room, so they can join it. Rooms can't be
    // listed, so codes can't be harvested.
    match /games/{roomId} {
      allow get: if request.auth != null;
      allow list: if false;

      // Create: the creator holds seat 0 and is the only authorized uid.
      allow create: if request.auth != null
        && request.resource.data.status == 'waiting'
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 1
        && request.resource.data.players.size() <= 6
        && request.resource.data.players[0].uid == request.auth.uid
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && request.resource.data.authorizedUids is list
        && request.resource.data.authorizedUids.hasOnly([request.auth.uid]);

      allow update: if request.auth != null
        && request.resource.data.id == resource.data.id
        && request.resource.data.status in ['waiting', 'playing', 'finished']
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 1
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.players[0].uid == resource.data.players[0].uid
        && request.resource.data.authorizedUids.hasAll(resource.data.authorizedUids)
        && (isMember() || isJoin())
        // Only the host starts or finishes a game.
        && (resource.data.status != 'waiting'
            || request.resource.data.status != 'playing'
            || request.auth.uid == resource.data.players[0].uid)
        && (resource.data.status == 'finished'
            || request.resource.data.status != 'finished'
            || request.auth.uid == resource.data.players[0].uid);

      // Members play: the uid list stays the same.
      function isMember() {
        return request.auth.uid in resource.data.authorizedUids
          && request.resource.data.authorizedUids == resource.data.authorizedUids;
      }

      // Joining: someone not yet in the room adds exactly their own uid and
      // their seat, without touching anything else about the room. syncId is
      // what the current live client bumps when someone takes over an AI seat.
      function isJoin() {
        return !(request.auth.uid in resource.data.authorizedUids)
          && request.resource.data.authorizedUids.size() == resource.data.authorizedUids.size() + 1
          && request.auth.uid in request.resource.data.authorizedUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['players', 'authorizedUids', 'updatedAt', 'gameState', 'stateVersion', 'syncId']);
      }

      // No client-side deletes; a scheduled function clears rooms after 24 hours.
      allow delete: if false;
    }

    // ── User stats ───────────────────────────────────────────────────────────
    match /userStats/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Santa Cruz Vampire RPG (same Firebase project) ──────────────────────
    // Deploying these rules replaces the whole project's rule set, so the
    // RPG's collections live here too: each player reads and writes only
    // their own profile and save.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /gameSaves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
