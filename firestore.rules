rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Game rooms ──────────────────────────────────────────────────────────
    match /games/{roomId} {
      // Reading a room requires the caller to be an authorized participant
      allow read: if request.auth != null
        && request.auth.uid in resource.data.authorizedUids;

      // Create: authenticated user, valid initial shape, and authorizedUids
      // must contain exactly the creator's UID (others are added via arrayUnion on join)
      allow create: if request.auth != null
        && request.resource.data.status == 'waiting'
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 1
        && request.resource.data.players.size() <= 4
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && request.resource.data.authorizedUids is list
        && request.resource.data.authorizedUids.hasOnly([request.auth.uid]);

      // Update: only authorized participants may overwrite game state;
      // room id immutable, status must be valid, player list cannot be empty,
      // updatedAt must advance, and authorizedUids may only have the caller's
      // own UID added (never removed, never a stranger's UID injected)
      allow update: if request.auth != null
        && request.auth.uid in resource.data.authorizedUids
        && request.resource.data.id == resource.data.id
        && request.resource.data.status in ['waiting', 'playing', 'finished']
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 1
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.authorizedUids.hasAll(resource.data.authorizedUids)
        && (request.resource.data.authorizedUids == resource.data.authorizedUids
            || (request.resource.data.authorizedUids.size() == resource.data.authorizedUids.size() + 1
                && request.auth.uid in request.resource.data.authorizedUids));

      // No client-side deletes — cleanup is handled server-side
      allow delete: if false;
    }

    // ── User stats ───────────────────────────────────────────────────────────
    match /userStats/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
